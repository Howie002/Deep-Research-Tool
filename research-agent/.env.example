# ──────────────────────────────────────────────
# LM Studio Configuration
# ──────────────────────────────────────────────
# Base URL for LM Studio's local server (default port is 1234)
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# Model name as shown in LM Studio. To find it, run:
#   curl http://localhost:1234/v1/models
# and copy the "id" field from the response.
LM_STUDIO_MODEL=local-model

# ──────────────────────────────────────────────
# Search Backend
# ──────────────────────────────────────────────
# Options: "duckduckgo" (default, no key needed), "brave", "serpapi", "langsearch"
# Falls back to duckduckgo automatically if the required API key is not set.
SEARCH_BACKEND=duckduckgo

# Brave Search API key — only needed if SEARCH_BACKEND=brave
# Get a key at: https://brave.com/search/api/
BRAVE_API_KEY=

# SerpAPI key — only needed if SEARCH_BACKEND=serpapi
# Get a key at: https://serpapi.com/
SERPAPI_KEY=

# LangSearch API key — only needed if SEARCH_BACKEND=langsearch
# Get a free key at: https://langsearch.com/dashboard
LANGSEARCH_API_KEY=

# ──────────────────────────────────────────────
# REST API Server
# ──────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# API key for X-API-Key header authentication. Leave empty to disable auth.
API_KEY=

# Allowed CORS origins, comma-separated. Defaults to * (open) when unset.
CORS_ORIGINS=*

# ──────────────────────────────────────────────
# MCP Server
# ──────────────────────────────────────────────
MCP_SERVER_NAME=research-agent

# ──────────────────────────────────────────────
# Research Behaviour
# ──────────────────────────────────────────────
# Number of web search results to fetch per query
MAX_SEARCH_RESULTS=5

# Max characters to read from each fetched webpage (keeps context from bloating)
MAX_PAGE_CONTENT_LENGTH=4000

# How long (in seconds) to cache identical search query results in memory (default: 300)
SEARCH_CACHE_TTL_SECONDS=300

# Job timeout in seconds. Default: 10800 (3 hours). Increase for slow hardware.
JOB_TIMEOUT_SECONDS=10800
